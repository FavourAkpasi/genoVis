# Copy to .env. Every value is optional — leave Sentry blank to run without it.

# --- Sentry runtime (inlined into the bundle; the DSN is public by design) ---
# Project Settings → Client Keys (DSN)
PUBLIC_SENTRY_DSN=
# Defaults to NODE_ENV (development / production) when blank
PUBLIC_SENTRY_ENVIRONMENT=

# --- Sentry source-map upload (production builds only; SECRET — never commit) ---
# Settings → Developer Settings → Organization Tokens (scope: project:releases / org:ci)
SENTRY_AUTH_TOKEN=
# Organization slug and project slug, as they appear in your Sentry URLs
SENTRY_ORG=
SENTRY_PROJECT=
